function PV_init() {
  textWidth = Math.ceil(Game.width / (textSize * textScX) / 1.86) + 2
  textHeight = Math.ceil(Game.height / textSize)
  totalPixels = textWidth * textHeight
  for (let i = 0; i < totalPixels; i++) {
    const x = i % textWidth
    const y = Math.floor(i / textWidth)
    const t = Game.createText("██", {
      fontSize: textSize,
      fontFamily: "Cascadia Mono",
      lineHeight: textSize * 1.15,
      letterSpacing: -0.85,
      align: "center",
    })
    t.x = -Game.width / 2 + textSize / 2 + x * textSize + 1
    t.y = -Game.height / 2 + textSize / 2 + y * textSize
    textObjects.push(t)
    pixelColors.push(0)
  }
}

function PV_initZBuffer() {
  for (let i = 0; i < totalPixels; i++) {
    zBuffer[i] = -65536
  }
}

function PV_clearZBuffer() {
  zBuffer.fill(-65536)
}

function PV_setPixel(x: number, y: number, color: number) {
  if (x < 0 || x >= textWidth || y < 0 || y >= textHeight) return
  const index = y * textWidth + x
  if (pixelColors[index] !== color) {
    textObjects[index].style.fill = color
    pixelColors[index] = color
  }
}

function PV_getPixel(x: number, y: number): number | null {
  if (x < 0 || x >= textWidth || y < 0 || y >= textHeight) return null
  return pixelColors[y * textWidth + x]
}

function PV_drawTriangle(p0: Vec3, p1: Vec3, p2: Vec3, color: number) {
  const sx = [p0[0], p1[0], p2[0]]
  const sy = [p0[1], p1[1], p2[1]]
  const width = Math.max(...(sx as any)) - Math.min(...(sx as any))
  const height = Math.max(...(sy as any)) - Math.min(...(sy as any))

  if (width < 1 || height < 1) return

  const mapX = (x: number) => ((x + SW2) / (SW2 * 2)) * textWidth
  const mapY = (y: number) => ((y + SH2) / (SH2 * 2)) * textHeight

  const x0f = mapX(p0[0])
  const y0f = mapY(p0[1])
  const x1f = mapX(p1[0])
  const y1f = mapY(p1[1])
  const x2f = mapX(p2[0])
  const y2f = mapY(p2[1])

  const padding = 1
  const minX = Math.max(0, Math.floor(Math.min(x0f, x1f, x2f)) - padding)
  const maxX = Math.min(
    textWidth - 1,
    Math.ceil(Math.max(x0f, x1f, x2f)) + padding,
  )
  const minY = Math.max(0, Math.floor(Math.min(y0f, y1f, y2f)) - padding)
  const maxY = Math.min(
    textHeight - 1,
    Math.ceil(Math.max(y0f, y1f, y2f)) + padding,
  )

  const edgeFunction = (
    x0: number,
    y0: number,
    x1: number,
    y1: number,
    x: number,
    y: number,
  ) => (y0 - y1) * x + (x1 - x0) * y + x0 * y1 - x1 * y0

  const area = edgeFunction(x0f, y0f, x1f, y1f, x2f, y2f)
  if (area === 0) return

  const e = 0.01 // leicht erhöht für Kanten-Lücken

  for (let y = minY; y <= maxY; y++) {
    for (let x = minX; x <= maxX; x++) {
      const w0 = edgeFunction(x1f, y1f, x2f, y2f, x + 0.5, y + 0.5) / area
      const w1 = edgeFunction(x2f, y2f, x0f, y0f, x + 0.5, y + 0.5) / area
      const w2 = edgeFunction(x0f, y0f, x1f, y1f, x + 0.5, y + 0.5) / area

      if (w0 >= -e && w1 >= -e && w2 >= -e) {
        const z = -(w0 * p0[2] + w1 * p1[2] + w2 * p2[2])
        const ix = Math.round(x)
        const iy = Math.round(y)
        const index = iy * textWidth + ix
        const last = PV_getPixel(ix, iy)
        /*if (last) {
          //PV_setPixel(ix, iy, blendColor(color, last, 0.3))
        }*/

        // Optional Z-Puffer
        if (z > zBuffer[index]) {
          PV_setPixel(ix, iy, color)
          zBuffer[index] = z
        }
      }
    }
  }
}

function PV_drawTriangleTextured(
  p0: Vec3,
  p1: Vec3,
  p2: Vec3,
  uvs: [Vec2, Vec2, Vec2],
  texId: string,
) {
  //console.log(globals.textureAtlas)
  const tex = globals.textureAtlas.find((t) => t.id === texId)
  if (!tex) return

  const mapX = (x: number) => ((x + SW2) / (SW2 * 2)) * textWidth
  const mapY = (y: number) => ((y + SH2) / (SH2 * 2)) * textHeight

  const x0f = mapX(p0[0]),
    y0f = mapY(p0[1])
  const x1f = mapX(p1[0]),
    y1f = mapY(p1[1])
  const x2f = mapX(p2[0]),
    y2f = mapY(p2[1])

  const edgeFunction = (
    x0: number,
    y0: number,
    x1: number,
    y1: number,
    x: number,
    y: number,
  ) => (y0 - y1) * x + (x1 - x0) * y + x0 * y1 - x1 * y0

  const area = edgeFunction(x0f, y0f, x1f, y1f, x2f, y2f)
  if (area === 0) return

  const minX = Math.max(0, Math.floor(Math.min(x0f, x1f, x2f)))
  const maxX = Math.min(textWidth - 1, Math.ceil(Math.max(x0f, x1f, x2f)))
  const minY = Math.max(0, Math.floor(Math.min(y0f, y1f, y2f)))
  const maxY = Math.min(textHeight - 1, Math.ceil(Math.max(y0f, y1f, y2f)))

  const [uv0, uv1, uv2] = uvs

  for (let y = minY; y <= maxY; y++) {
    for (let x = minX; x <= maxX; x++) {
      const w0 = edgeFunction(x1f, y1f, x2f, y2f, x + 0.5, y + 0.5) / area
      const w1 = edgeFunction(x2f, y2f, x0f, y0f, x + 0.5, y + 0.5) / area
      const w2 = edgeFunction(x0f, y0f, x1f, y1f, x + 0.5, y + 0.5) / area

      if (w0 >= 0 && w1 >= 0 && w2 >= 0) {
        //const u = w0 * uv0[0] + w1 * uv1[0] + w2 * uv2[0]
        //const v = w0 * uv0[1] + w1 * uv1[1] + w2 * uv2[1]
        const z0 = 1 / p0[2]
        const z1 = 1 / p1[2]
        const z2 = 1 / p2[2]

        const invZ = w0 * z0 + w1 * z1 + w2 * z2

        const u =
          (w0 * uv0[0] * z0 + w1 * uv1[0] * z1 + w2 * uv2[0] * z2) / invZ
        const v =
          (w0 * uv0[1] * z0 + w1 * uv1[1] * z1 + w2 * uv2[1] * z2) / invZ

        let color: number

        const uWrapped = u % 1
        const vWrapped = v % 1
        if (useLinear) {
          const txF = uWrapped * (tex.xs - 1)
          const tyF = vWrapped * (tex.ys - 1)
          const x0t = Math.floor(txF)
          const y0t = Math.floor(tyF)
          const x1t = Math.min(x0t + 1, tex.xs - 1)
          const y1t = Math.min(y0t + 1, tex.ys - 1)
          const fx = txF - x0t
          const fy = tyF - y0t

          const getColor = (ix: number, iy: number) =>
            tex.texture[iy * tex.xs + ix]
          const c00 = getColor(x0t, y0t)
          const c10 = getColor(x1t, y0t)
          const c01 = getColor(x0t, y1t)
          const c11 = getColor(x1t, y1t)

          const lerp = (a: number, b: number, t: number) => a + (b - a) * t

          const r = lerp(
            lerp((c00 >> 16) & 0xff, (c10 >> 16) & 0xff, fx),
            lerp((c01 >> 16) & 0xff, (c11 >> 16) & 0xff, fx),
            fy,
          )
          const g = lerp(
            lerp((c00 >> 8) & 0xff, (c10 >> 8) & 0xff, fx),
            lerp((c01 >> 8) & 0xff, (c11 >> 8) & 0xff, fx),
            fy,
          )
          const b = lerp(
            lerp(c00 & 0xff, c10 & 0xff, fx),
            lerp(c01 & 0xff, c11 & 0xff, fx),
            fy,
          )

          color = (Math.floor(r) << 16) | (Math.floor(g) << 8) | Math.floor(b)
        } else {
          const tx = Math.floor(uWrapped * tex.xs)
          const ty = Math.floor(vWrapped * tex.ys)
          color = tex.texture[ty * tex.xs + tx]
        }

        const z = -(w0 * p0[2] + w1 * p1[2] + w2 * p2[2])
        const index = y * textWidth + x
        if (z > zBuffer[index]) {
          PV_setPixel(x, y, color)
          zBuffer[index] = z
        }
      }
    }
  }
}

function PV_drawTriangleRGB(
  p0: Vec3,
  p1: Vec3,
  p2: Vec3,
  c0: number,
  c1: number,
  c2: number,
) {
  const mapX = (x: number) => ((x + SW2) / (SW2 * 2)) * textWidth
  const mapY = (y: number) => ((y + SH2) / (SH2 * 2)) * textHeight

  const x0 = mapX(p0[0]),
    y0 = mapY(p0[1])
  const x1 = mapX(p1[0]),
    y1 = mapY(p1[1])
  const x2 = mapX(p2[0]),
    y2 = mapY(p2[1])

  const edge = (
    x0: number,
    y0: number,
    x1: number,
    y1: number,
    x: number,
    y: number,
  ) => (y0 - y1) * x + (x1 - x0) * y + x0 * y1 - x1 * y0

  const area = edge(x0, y0, x1, y1, x2, y2)
  if (area === 0) return

  const minX = Math.max(0, Math.floor(Math.min(x0, x1, x2)))
  const maxX = Math.min(textWidth - 1, Math.ceil(Math.max(x0, x1, x2)))
  const minY = Math.max(0, Math.floor(Math.min(y0, y1, y2)))
  const maxY = Math.min(textHeight - 1, Math.ceil(Math.max(y0, y1, y2)))

  const lerp = (a: number, b: number, t: number) => a + (b - a) * t

  for (let y = minY; y <= maxY; y++) {
    for (let x = minX; x <= maxX; x++) {
      const w0 = edge(x1, y1, x2, y2, x + 0.5, y + 0.5) / area
      const w1 = edge(x2, y2, x0, y0, x + 0.5, y + 0.5) / area
      const w2 = edge(x0, y0, x1, y1, x + 0.5, y + 0.5) / area

      if (w0 >= 0 && w1 >= 0 && w2 >= 0) {
        // Interpolation der Farben
        const r = Math.floor(
          w0 * ((c0 >> 16) & 0xff) +
            w1 * ((c1 >> 16) & 0xff) +
            w2 * ((c2 >> 16) & 0xff),
        )
        const g = Math.floor(
          w0 * ((c0 >> 8) & 0xff) +
            w1 * ((c1 >> 8) & 0xff) +
            w2 * ((c2 >> 8) & 0xff),
        )
        const b = Math.floor(
          w0 * (c0 & 0xff) + w1 * (c1 & 0xff) + w2 * (c2 & 0xff),
        )
        const color = (r << 16) | (g << 8) | b

        const z = -(w0 * p0[2] + w1 * p1[2] + w2 * p2[2])
        const index = y * textWidth + x
        if (z > zBuffer[index]) {
          PV_setPixel(x, y, color)
          zBuffer[index] = z
        }
      }
    }
  }
}

