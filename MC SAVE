        let [px, py, pz] = [bx, by, bz] as any
        const rayDir = cameraRayForHit()
        if (camera.hitSide === "x") px -= rayDir[0] > 0 ? 1 : -1
        if (camera.hitSide === "y") py -= rayDir[1] > 0 ? 1 : -1
        if (camera.hitSide === "z") pz -= rayDir[2] > 0 ? 1 : -1

        if (getBlockWorld(px, py, pz) === blockTypes.air) {
          const cx = Math.floor(px / sChunkX),
            cz = Math.floor(pz / sChunkZ),
            cy = Math.floor(py)
          const chunk = getChunkAt(cx, cz)
          if (!chunk) return
          const lx = ((px % sChunkX) + sChunkX) % sChunkX
          const lz = ((pz % sChunkZ) + sChunkZ) % sChunkZ
          const oldBlock = getBlock(chunk, lx, cy, lz)
          setBlock(chunk, lx, cy, lz, setBlockType)
          if (isInsideBlock()) {
            setBlock(chunk, lx, cy, lz, oldBlock)
          } else {
            updated = true
            if (camera.gamemode == gamemodes.survival && useItems) {
              //console.log("removing item: " + currentItem, globals.hotbar, globals.hotbar[globals.hotbarSlot])
              //currentItem.count -= 1
              currentItem.count -= 1
              //console.log(globals.inventory, currentItem)
              if (currentItem.count <= 0) {
                const rmIdx = findSelectedIndex(currentItem.slot)
                if (rmIdx) globals.inventory.splice(rmIdx, 1)
              }
              /*globals.hotbar[globals.hotbarSlot].count -= 1
            if (globals.hotbar[globals.hotbarSlot].count == 0) {
              globals.hotbar[globals.hotbarSlot].count = 0
              globals.hotbar[globals.hotbarSlot].item = null
            }*/
              globals.updateHotbar = 2
            }
          }
        }
      } else {
        console.warn("NON PLACEABLE ITEM!")
      }
    }
  }

  if (updated) {
    const cx = Math.floor(bx / sChunkX),
      cz = Math.floor(bz / sChunkZ),
      cy = Math.floor(by)
    const chunk = getChunkAt(cx, cz)
    const lx = ((bx % sChunkX) + sChunkX) % sChunkX
    const lz = ((bz % sChunkZ) + sChunkZ) % sChunkZ

    const neighbors: [number, number, boolean][] = [
      [1, 0, lx === sChunkX - 1],
      [-1, 0, lx === 0],
      [0, 1, lz === sChunkZ - 1],
      [0, -1, lz === 0],
    ]

    const toUpdate: chunk[] = chunk ? [chunk] : []
    for (const [dx, dz, shouldUpdate] of neighbors as any)
      if (shouldUpdate) {
        const nc = getChunkAt(cx + dx, cz + dz)
        if (nc) toUpdate.push(nc)
      }

    for (const c of toUpdate as any) {
      c.mesh = []
      buildChunkMesh(c)
    }
  }
}

