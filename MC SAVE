function renderScene3D() {
  for (let tri of scene as any) {
    if (isTextured(tri)) {
      if (!isFrontface(tri)) continue
      const a = vertexShader(tri[0])
      const b = vertexShader(tri[1])
      const c = vertexShader(tri[2])
      const uvs: [Vec2, Vec2, Vec2] = [tri[3], tri[4], tri[5]]
      const texture = tri[6]
      //console.log("!!: ", a, b, c, uvs[0], uvs[1], uvs[2], texture)
      fragmentShaderTextured(a, b, c, uvs, texture)
    } else {
      if (!isFrontface(tri)) continue
      const a = vertexShader(tri[0])
      const b = vertexShader(tri[1])
      const c = vertexShader(tri[2])
      const color = tri[3]
      fragmentShader(a, b, c, color)
    }
  }
}

function renderBlockOutline3D() {
  if (!camera.hitBlock) {
    //console.log("returned")
    return
  }
  const [bx, by, bz] = camera.hitBlock as any

  // Alle 8 Eckpunkte des Blocks
  const corners: Vec3[] = [
    [bx, by, bz],
    [bx + 1, by, bz],
    [bx, by + 1, bz],
    [bx + 1, by + 1, bz],
    [bx, by, bz + 1],
    [bx + 1, by, bz + 1],
    [bx, by + 1, bz + 1],
    [bx + 1, by + 1, bz + 1],
  ]

  // Transformiere in Screen-Space
  const projected = corners.map((c) => projectToScreen(vertexShader(c)))

  // Kanten des Würfels (Index-Paare)
  const edges = [
    [0, 1],
    [1, 3],
    [3, 2],
    [2, 0], // unten
    [4, 5],
    [5, 7],
    [7, 6],
    [6, 4], // oben
    [0, 4],
    [1, 5],
    [2, 6],
    [3, 7], // Seiten
  ]

  for (const [i1, i2] of edges as any) {
    const p1 = projected[i1]
    const p2 = projected[i2]
    if (renderType == (renderTypes.CloneVersion as any))
      drawLine(p1[0], p1[1], p2[0], p2[1], 4, 0x000000, Math.min(p1[2], p2[2]))
    else if (renderType == (renderTypes.PixelVersion as any)) {
      PV_drawLineNZB([p1[0], p1[1], p1[2]], [p2[0], p2[1], p2[2]], 0x000000)
    } else {
      PV_drawLineNZB([p1[0], p1[1], 0], [p2[0], p2[1], 0], 0x000000)
    }
  }
}

function renderSceneRaycast() {
  const maxDist = raycastDist

  for (let y = 0; y < textHeight; y++) {
    for (let x = 0; x < textWidth; x++) {
      const rayDir = cameraRayForPixel(x, y)

      const hit = voxelRaycastWorld(
        [camera.x, camera.y, camera.z],
        rayDir,
        maxDist,
      )

      const color = hit ? shade(hit.block, hit.face, hit.dist) : backgroundColor

      PV_setPixel(x, y, color)
    }
  }
}

function shade(block: blockTypes, face: "x" | "y" | "z", dist: number): number {
  // direkter Zugriff auf colorMap statt extra Map
  const colors = getBlockColors(block)
  if (!colors) return backgroundColor

  let baseColor: number
  switch (face) {
    case "x":
      baseColor = colors.eColor ?? colors.ssColor ?? colors.aColor
      break
    case "y":
      baseColor = colors.topColor
      break
    case "z":
      baseColor = colors.sColor ?? colors.ssColor ?? colors.aColor
      break
    default:
      baseColor = colors.aColor
  }

  //colorMap[blockTypes[block] as keyof typeof colorMap] ?? backgroundColor

  let r = (baseColor >> 16) & 0xff
  let g = (baseColor >> 8) & 0xff
  let b = baseColor & 0xff

  // einfache Helligkeit nach Face
  let brightness = 1.0
  if (face === "x") brightness = 0.7
  if (face === "y") brightness = 1.0
  if (face === "z") brightness = 0.5

  // Distanz-Faktor
  const fog = Math.max(0, dist / distColor)
  const distanceLightFactor = Math.max(0.1, 1.0 - fog)

  r = Math.floor(r * brightness * distanceLightFactor)
  g = Math.floor(g * brightness * distanceLightFactor)
  b = Math.floor(b * brightness * distanceLightFactor)

  const prefinal = (r << 16) | (g << 8) | b
  const blended = blendColor(prefinal, backgroundColor, fog)

  return blended
}

function cameraRayForPixel(px: number, py: number): Vec3 {
  const SW = textWidth
  const SH = textHeight

  const nx = (2 * (px + 0.5)) / SW - 1
  const ny = (2 * (py + 0.5)) / SH - 1

  let rx = nx * (SW / SH)
  let ry = ny
  let rz = 1

  const tempY_pitch = ry * camera.pitchCos + rz * camera.pitchSin
  const tempZ_pitch = -ry * camera.pitchSin + rz * camera.pitchCos
  ry = tempY_pitch
  rz = tempZ_pitch

  const tempX_yaw = rx * camera.yawCos + rz * camera.yawSin
  const tempZ_yaw = -rx * camera.yawSin + rz * camera.yawCos
  rx = tempX_yaw
  rz = tempZ_yaw

  const len = Math.hypot(rx, ry, rz)
  return [rx / len, ry / len, rz / len] as Vec3
}

function cameraRayForHit(): Vec3 {
  const nx = 0
  const ny = 0
  //drawDot(SW2,SH2, 5, 0xff0000, -10000)

  let rx = nx * (SW / SH)
  let ry = ny
  let rz = 1

  const tempY_pitch = ry * camera.pitchCos + rz * camera.pitchSin
  const tempZ_pitch = -ry * camera.pitchSin + rz * camera.pitchCos
  ry = tempY_pitch
  rz = tempZ_pitch

  const tempX_yaw = rx * camera.yawCos + rz * camera.yawSin
  const tempZ_yaw = -rx * camera.yawSin + rz * camera.yawCos
  rx = tempX_yaw
  rz = tempZ_yaw

  const len = Math.hypot(rx, ry, rz)
  return [rx / len, ry / len, rz / len] as Vec3
}

function voxelRaycastWorld(
  origin: [number, number, number],
  dir: [number, number, number],
  maxDist: number,
) {
  let [x, y, z] = origin
  let [dx, dy, dz] = dir

  let ix = Math.floor(x)
  let iy = Math.floor(y)
  let iz = Math.floor(z)

  const stepX = dx > 0 ? 1 : -1
  const stepY = dy > 0 ? 1 : -1
  const stepZ = dz > 0 ? 1 : -1

  const tDeltaX = Math.abs(1 / dx)
  const tDeltaY = Math.abs(1 / dy)
  const tDeltaZ = Math.abs(1 / dz)

  let tMaxX = (dx > 0 ? ix + 1 - x : x - ix) * tDeltaX
  let tMaxY = (dy > 0 ? iy + 1 - y : y - iy) * tDeltaY
  let tMaxZ = (dz > 0 ? iz + 1 - z : z - iz) * tDeltaZ

  let dist = 0
  let lastStep: "x" | "y" | "z" = "x"

  while (dist <= maxDist) {
    const block = getBlockWorld(ix, iy, iz)
    if (block !== blockTypes.air) {
      return { block, pos: [ix, iy, iz], face: lastStep, dist }
    }

    if (tMaxX < tMaxY && tMaxX < tMaxZ) {
      ix += stepX
      dist = tMaxX
      tMaxX += tDeltaX
      lastStep = "x"
    } else if (tMaxY < tMaxZ) {
      iy += stepY
      dist = tMaxY
      tMaxY += tDeltaY
      lastStep = "y"
    } else {
      iz += stepZ
      dist = tMaxZ
      tMaxZ += tDeltaZ
      lastStep = "z"
    }
  }

  return null
}

function vertexShader(p: Vec3): Vec3 {
  const dx = p[0] - camera.x
  const dy = p[1] - camera.y
  const dz = p[2] - camera.z

  const x1 = dx * camera.yawCos - dz * camera.yawSin
  const z1 = dx * camera.yawSin + dz * camera.yawCos

  const y2 = dy * camera.pitchCos - z1 * camera.pitchSin
  const z2 = dy * camera.pitchSin + z1 * camera.pitchCos

  return [x1, y2, z2]
}

function fragmentShader(a: Vec3, b: Vec3, c: Vec3, color: number) {
  const nearClipped = clipTriangleToNearZ(a, b, c, camera.nearZ)
  if (nearClipped.length === 0) return
  for (const triNC of nearClipped as any) {
    const p0 = projectToScreen(triNC[0])
    const p1 = projectToScreen(triNC[1])
    const p2 = projectToScreen(triNC[2])

    const screenClipped = clipTriangleToScreen(p0, p1, p2, SW2, SH2)
    for (const triSC of screenClipped as any) {
      drawTriangle(
        [
          triSC[0][0],
          triSC[0][1],
          triSC[1][0],
          triSC[1][1],
          triSC[2][0],
          triSC[2][1],
          triSC[0][2],
          triSC[1][2],
          triSC[2][2],
        ],
        color,
      )
    }
  }
}

function fragmentShaderTextured(
  a: Vec3,
  b: Vec3,
  c: Vec3,
  uvs: [Vec2, Vec2, Vec2],
  texId: string,
) {
  const nearClipped = clipTriangleToNearZWithUV(a, b, c, uvs, camera.nearZ)
  if (nearClipped.length === 0) return

  for (const tri of nearClipped as any) {
    const screenClipped = clipTriangleToScreenWithUV(
      tri[0].pos,
      tri[1].pos,
      tri[2].pos,
      [tri[0].uv, tri[1].uv, tri[2].uv],
      SW2,
      SH2,
    )

    for (const scTri of screenClipped as any) {
      const pa = projectToScreen(scTri[0].pos)
      const pb = projectToScreen(scTri[1].pos)
      const pc = projectToScreen(scTri[2].pos)

      PV_drawTriangleTextured(
        pa,
        pb,
        pc,
        [scTri[0].uv, scTri[1].uv, scTri[2].uv],
        texId,
      )
    }
  }
}

function clipTriangleToNearZ(
  a: Vec3,
  b: Vec3,
  c: Vec3,
  nearZ: number,
): Vec3[][] {
  let poly: Vec3[] = [a, b, c]

  poly = clipPolygon(
    poly,
    (p) => p[2] >= nearZ, // Punkte vor der Kamera sind drin
    (p1, p2) => intersectZ(p1, p2, nearZ), // Schnittpunkt mit nearZ
  )

  if (poly.length < 3) return []

  const tris: Vec3[][] = []
  for (let i = 1; i < poly.length - 1; i++) {
    tris.push([poly[0], poly[i], poly[i + 1]])
  }
  return tris
}

function intersectZ(p1: Vec3, p2: Vec3, zClip: number): Vec3 {
  const t = (zClip - p1[2]) / (p2[2] - p1[2])
  return [p1[0] + t * (p2[0] - p1[0]), p1[1] + t * (p2[1] - p1[1]), zClip]
}

function clipTriangleToScreen(
  a: Vec3,
  b: Vec3,
  c: Vec3,
  SW2: number,
  SH2: number,
): Vec3[][] {
  let poly: Vec3[] = [a, b, c]

  // clip sequentially against 4 boundaries
  poly = clipPolygon(
    poly,
    (p) => p[0] >= -SW2,
    (p1, p2) => intersectX(p1, p2, -SW2),
  )
  poly = clipPolygon(
    poly,
    (p) => p[0] <= SW2,
    (p1, p2) => intersectX(p1, p2, SW2),
  )
  poly = clipPolygon(
    poly,
    (p) => p[1] >= -SH2,
    (p1, p2) => intersectY(p1, p2, -SH2),
  )
  poly = clipPolygon(
    poly,
    (p) => p[1] <= SH2,
    (p1, p2) => intersectY(p1, p2, SH2),
  )

  if (poly.length < 3) return [] // nichts sichtbar

  // triangulate polygon fan-style
  const tris: Vec3[][] = []
  for (let i = 1; i < poly.length - 1; i++) {
    tris.push([poly[0], poly[i], poly[i + 1]])
  }
  return tris
}

function clipPolygon(
  poly: Vec3[],
  inside: (p: Vec3) => boolean,
  intersect: (p1: Vec3, p2: Vec3) => Vec3,
): Vec3[] {
  const output: Vec3[] = []
  for (let i = 0; i < poly.length; i++) {
    const curr = poly[i]
    const prev = poly[(i + poly.length - 1) % poly.length]
    const currIn = inside(curr)
    const prevIn = inside(prev)

    if (currIn && prevIn) {
      // beide drin
      output.push(curr)
    } else if (prevIn && !currIn) {
      // rausgehend → Schnittpunkt
      output.push(intersect(prev, curr))
    } else if (!prevIn && currIn) {
      // reinkommend → Schnittpunkt + Punkt
      output.push(intersect(prev, curr))
      output.push(curr)
    }
    // beide draußen → nix
  }
  return output
}

type VertexUV = { pos: Vec3; uv: Vec2 }

function clipTriangleToNearZWithUV(
  a: Vec3,
  b: Vec3,
  c: Vec3,
  uvs: [Vec2, Vec2, Vec2],
  nearZ: number,
): VertexUV[][] {
  let poly: VertexUV[] = [
    { pos: a, uv: uvs[0] },
    { pos: b, uv: uvs[1] },
    { pos: c, uv: uvs[2] },
  ]

  poly = clipPolygonUV(
    poly,
    (v) => v.pos[2] >= nearZ,
    (v1, v2) => intersectZWithUV(v1, v2, nearZ),
  )
  if (poly.length < 3) return []

  const tris: VertexUV[][] = []
  for (let i = 1; i < poly.length - 1; i++) {
    tris.push([poly[0], poly[i], poly[i + 1]])
  }
  return tris
}

function intersectZWithUV(v1: VertexUV, v2: VertexUV, zClip: number): VertexUV {
  const t = (zClip - v1.pos[2]) / (v2.pos[2] - v1.pos[2])
  return {
    pos: [
      v1.pos[0] + t * (v2.pos[0] - v1.pos[0]),
      v1.pos[1] + t * (v2.pos[1] - v1.pos[1]),
      zClip,
    ],
    uv: [
      v1.uv[0] + t * (v2.uv[0] - v1.uv[0]),
      v1.uv[1] + t * (v2.uv[1] - v1.uv[1]),
    ],
  }
}

function clipTriangleToScreenWithUV(
  a: Vec3,
  b: Vec3,
  c: Vec3,
  uvs: [Vec2, Vec2, Vec2],
  SW2: number,
  SH2: number,
): VertexUV[][] {
  let poly: VertexUV[] = [
    { pos: a, uv: uvs[0] },
    { pos: b, uv: uvs[1] },
    { pos: c, uv: uvs[2] },
  ]

  poly = clipPolygonUV(
    poly,
    (v) => v.pos[0] >= -SW2,
    (v1, v2) => intersectXWithUV(v1, v2, -SW2),
  )
  poly = clipPolygonUV(
    poly,
    (v) => v.pos[0] <= SW2,
    (v1, v2) => intersectXWithUV(v1, v2, SW2),
  )
  poly = clipPolygonUV(
    poly,
    (v) => v.pos[1] >= -SH2,
    (v1, v2) => intersectYWithUV(v1, v2, -SH2),
  )
  poly = clipPolygonUV(
    poly,
    (v) => v.pos[1] <= SH2,
    (v1, v2) => intersectYWithUV(v1, v2, SH2),
  )

  if (poly.length < 3) return []

  const tris: VertexUV[][] = []
  for (let i = 1; i < poly.length - 1; i++) {
    tris.push([poly[0], poly[i], poly[i + 1]])
  }
  return tris
}

function intersectXWithUV(v1: VertexUV, v2: VertexUV, xClip: number): VertexUV {
  const t = (xClip - v1.pos[0]) / (v2.pos[0] - v1.pos[0])
  return {
    pos: [
      xClip,
      v1.pos[1] + t * (v2.pos[1] - v1.pos[1]),
      v1.pos[2] + t * (v2.pos[2] - v1.pos[2]),
    ],
    uv: [
      v1.uv[0] + t * (v2.uv[0] - v1.uv[0]),
      v1.uv[1] + t * (v2.uv[1] - v1.uv[1]),
    ],
  }
}

function intersectYWithUV(v1: VertexUV, v2: VertexUV, yClip: number): VertexUV {
  const t = (yClip - v1.pos[1]) / (v2.pos[1] - v1.pos[1])
  return {
    pos: [
      v1.pos[0] + t * (v2.pos[0] - v1.pos[0]),
      yClip,
      v1.pos[2] + t * (v2.pos[2] - v1.pos[2]),
    ],
    uv: [
      v1.uv[0] + t * (v2.uv[0] - v1.uv[0]),
      v1.uv[1] + t * (v2.uv[1] - v1.uv[1]),
    ],
  }
}

function clipPolygonUV(
  poly: VertexUV[],
  inside: (v: VertexUV) => boolean,
  intersect: (v1: VertexUV, v2: VertexUV) => VertexUV,
): VertexUV[] {
  const output: VertexUV[] = []
  for (let i = 0; i < poly.length; i++) {
    const curr = poly[i]
    const prev = poly[(i + poly.length - 1) % poly.length]
    const currIn = inside(curr)
    const prevIn = inside(prev)

    if (currIn && prevIn) {
      output.push(curr)
    } else if (prevIn && !currIn) {
      output.push(intersect(prev, curr))
    } else if (!prevIn && currIn) {
      output.push(intersect(prev, curr))
      output.push(curr)
    }
  }
  return output
}

function intersectX(p1: Vec3, p2: Vec3, xClip: number): Vec3 {
  const t = (xClip - p1[0]) / (p2[0] - p1[0])
  return [xClip, p1[1] + t * (p2[1] - p1[1]), p1[2] + t * (p2[2] - p1[2])]
}

function intersectY(p1: Vec3, p2: Vec3, yClip: number): Vec3 {
  const t = (yClip - p1[1]) / (p2[1] - p1[1])
  return [p1[0] + t * (p2[0] - p1[0]), yClip, p1[2] + t * (p2[2] - p1[2])]
}

function hash2D(x: number, y: number): number {
  const s = Math.sin(x * 127.1 + y * 311.7) * 43758.5453
  return s - Math.floor(s)
}

function colorFromPos(x: number, y: number): number {
  const r = Math.floor(hash2D(x, y) * 255)
  const g = Math.floor(hash2D(x + 19.19, y + 47.77) * 255)
  const b = Math.floor(hash2D(x + 73.31, y + 12.34) * 255)
  return (r << 16) | (g << 8) | b
}

function isFrontface(tri: Triangle): boolean {
  const p1 = tri[0]
  const p2 = tri[1]
  const p3 = tri[2]

  const ux = p2[0] - p1[0]
  const uy = p2[1] - p1[1]
  const uz = p2[2] - p1[2]

  const vx = p3[0] - p1[0]
  const vy = p3[1] - p1[1]
  const vz = p3[2] - p1[2]

  const dx = p1[0] - camera.x
  const dy = p1[1] - camera.y
  const dz = p1[2] - camera.z

  const dot =
    (uy * vz - uz * vy) * dx +
    (uz * vx - ux * vz) * dy +
    (ux * vy - uy * vx) * dz

  return dot < 0
}

function projectToScreen(p: Vec3): Vec3 {
  const s = camera.scale
  const f = camera.focalLength
  const x = (p[0] / p[2] / s) * f
  const y = (p[1] / p[2] / s) * f
  return [x, y, p[2]]
}

function drawTriangle(points: number[], color: number) {
  if (
    Math.max(points[0], points[2], points[4]) -
      Math.min(points[0], points[2], points[4]) <
    1
  )
    return
  if (
    Math.max(points[1], points[3], points[5]) -
      Math.min(points[1], points[3], points[5]) <
    1
  )
    return
  if (renderType == renderTypes.CloneVersion) {
    CV_drawTriangle(
      points[0],
      points[1],
      points[2],
      points[3],
      points[4],
      points[5],
      color,
      -(points[6] + points[7] + points[8]),
    )
  } else if (renderType == renderTypes.PixelVersion) {
    PV_drawTriangle(
      [points[0], points[1], points[6]],
      [points[2], points[3], points[7]],
      [points[4], points[5], points[8]],
      color,
    )
  } else {
    console.warn("ADD OTHER RENDER TYPE HERE")
  }
}

function addCube(center: Vec3, size: number = 1, colors?: any) {
  const c = size / 2
  const cx = center[0]
  const cy = center[1]
  const cz = center[2]

  const v: Vec3[] = [
    [-c, -c, -c],
    [c, -c, -c],
    [-c, c, -c],
    [c, c, -c],
    [-c, -c, c],
    [c, -c, c],
    [-c, c, c],
    [c, c, c],
  ]

  for (let i = 0; i < v.length; i++) {
    v[i][0] += cx
    v[i][1] += cy
    v[i][2] += cz
  }

  const col = colors || {
    front: 0xff0000,
    back: 0x00ff00,
    top: 0x0000ff,
    bottom: 0xffff00,
    left: 0xff00ff,
    right: 0x00ffff,
  }

  const push = (i1: number, i2: number, i3: number, color: number) =>
    scene.push([v[i1], v[i2], v[i3], color])

  // Front
  push(4, 5, 7, col.front)
  push(4, 7, 6, col.front)
  // Back
  push(1, 0, 2, col.back)
  push(1, 2, 3, col.back)
  // Top
  push(2, 6, 7, col.top)
  push(2, 7, 3, col.top)
  // Bottom
  push(0, 1, 5, col.bottom)
  push(0, 5, 4, col.bottom)
  // Left
  push(0, 4, 6, col.left)
  push(0, 6, 2, col.left)
  // Right
  push(5, 1, 3, col.right)
  push(5, 3, 7, col.right)
}

