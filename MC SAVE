    [cx - halfSize, cy + halfSize, cz - halfSize],
    [cx + halfSize, cy + halfSize, cz - halfSize],
    [cx - halfSize, cy - halfSize, cz + halfSize],
    [cx + halfSize, cy - halfSize, cz + halfSize],
    [cx - halfSize, cy + halfSize, cz + halfSize],
