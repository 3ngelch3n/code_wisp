function processChunkQueue() {
  const maxJobsPerTick = 1 // z. B. 1 Chunk pro Frame
  for (let i = 0; i < maxJobsPerTick; i++) {
    const job = getNextJob()
    if (!job) return
    //console.log("JOB: ", job)

    switch (job.type) {
      case "load": {
        const gc = generateChunk(job.x, job.z) // generiere Standardchunk
        const cChange = chunkChanges.find(
          (ch) => ch.cx === job.x && ch.cz === job.z,
        )

        if (cChange) {
          // Ganze Subchunks überschreiben
          if (cChange.subChunks) {
            for (const changedSC of cChange.subChunks as any) {
              const sc = gc.subChunks.find((s) => s.y === changedSC.y)
              if (sc) sc.blocks = [...changedSC.blocks]
            }
          }

          // Einzelne Blockänderungen anwenden
          if (cChange.blockChange) {
