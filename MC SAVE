// Definiere, welche Blocktypen Texturen haben
function getBlockTexture(
  blockType: blockTypes,
  face: "top" | "bottom" | "left" | "right" | "front" | "back" | "side",
): string | undefined {
  switch (blockType) {
    case blockTypes.grass:
      if (face === "top") return "grass_top"
      if (face === "bottom") return "dirt"
      return "grass_side"
    case blockTypes.dirt:
      return "dirt"
    case blockTypes.stone:
      return "stone"
    case blockTypes.bedrock:
      return "bedrock"
    case blockTypes.oak_log:
      if (face === "top" || face === "bottom") return "oak_log"
      return "oak_planks"
    case blockTypes.birch_log:
      if (face === "top" || face === "bottom") return "birch_log"
      return "birch_planks"
    case blockTypes.cactus:
      if (face === "top" || face === "bottom") return "cactus_top"
      return "cactus"
    case blockTypes.oak_planks:
      return "oak_planks"
    case blockTypes.spruce_planks:
      return "spruce_planks"
    case blockTypes.birch_planks:
      return "birch_planks"
    case blockTypes.coal_block:
      return "coal_block"
    case blockTypes.coal_ore:
      return "coal_ore"
    case blockTypes.stonebrick:
      return "stonebrick"
    case blockTypes.diamond_block:
      return "diamond_block"
    case blockTypes.diamond_ore:
      return "diamond_ore"
    case blockTypes.iron_block:
      return "iron_block"
    case blockTypes.iron_ore:
      return "iron_ore"
    case blockTypes.gravel:
      return "gravel"
    case blockTypes.deadbush:
      return "deadbush"
    case blockTypes.fern:
      return "fern"
    case blockTypes.tall_grass:
      return "tall_grass"
    case blockTypes.redstone:
      return "redstone"
    case blockTypes.sand:
      return "sand"
    case blockTypes.sandstone:
      if (face === "top" || face === "bottom") return "sand"
      else return "sandstone"
    default:
      return undefined
  }
}

function addQuadTop(
  start: Vec3,
  w: number,
  h: number,
  blockType: blockTypes,
  c: chunk,
) {
  const x0 = start[0]
  const y = start[1]
  const z0 = start[2]

  const colors = getBlockColors(blockType)
  const color = colors ? colors.topColor : 0xffffff
  let texId = undefined
  if (TEXTURES_ENABLED) texId = getBlockTexture(blockType, "top") // Funktion, die optional Textur liefert

  const v0: Vec3 = [x0, y + 1, z0]
  const v1: Vec3 = [x0 + w, y + 1, z0]
  const v2: Vec3 = [x0, y + 1, z0 + h]
  const v3: Vec3 = [x0 + w, y + 1, z0 + h]

  const uv0: Vec2 = [0, 0]
  const uv1: Vec2 = [w, 0]
  const uv2: Vec2 = [0, h]
  const uv3: Vec2 = [w, h]

  if (texId) {
    c.mesh.push([v0, v3, v1, uv0, uv3, uv1, texId] as TriangleTexture)
    c.mesh.push([v0, v2, v3, uv0, uv2, uv3, texId] as TriangleTexture)
  } else {
    c.mesh.push([v0, v3, v1, color] as TriangleColor)
    c.mesh.push([v0, v2, v3, color] as TriangleColor)
  }
}

function addQuadBottom(
  start: Vec3,
  w: number,
  h: number,
  blockType: blockTypes,
  c: chunk,
) {
  const x0 = start[0]
  const y = start[1]
  const z0 = start[2]

