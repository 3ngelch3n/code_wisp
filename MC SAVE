function updateChunks() {
  const cP = worldToChunk(camera.x, camera.z)

  for (let dx = -LOAD_RADIUS; dx <= LOAD_RADIUS; dx++) {
    for (let dz = -LOAD_RADIUS; dz <= LOAD_RADIUS; dz++) {
      const dist = Math.sqrt(dx * dx + dz * dz)
      const cx = cP.cx + dx
      const cz = cP.cz + dz
      const chunk = getChunkAt(cx, cz)

      // Laden wenn fehlt
      if (dist <= LOAD_RADIUS && !chunk) {
        //console.log("load!! ", cx, cz, getChunkAt(cx, cz))
        queueJob(cx, cz, "load", dist)
        continue
      }
      if (!chunk) continue

      // Mesh bauen wenn nah
      if (dist <= RENDER_RADIUS && chunk.has_mesh === false) {
        queueJob(cx, cz, "mesh", dist + 5)
      }

      if (dist > RENDER_RADIUS && chunk.has_mesh === true) {
        //console.log("UNMESH")
        queueJob(cx, cz, "unmesh", dist)
      }

      if (dist > LOAD_RADIUS) {
        //console.log("UNLOAD")
        queueJob(cx, cz, "unload", dist)
      }
    }
  }
  if (chunkQueue.length > 0) {
