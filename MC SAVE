    height: distance(p1, p2) * yPixelSize,
    x: (p1.x + p2.x) / 2,
    y: (p1.y + p2.y) / 2,
    rotation: angleBetween(p1, p2),
    texture: "square_yh",
    color: c,
    dist: d,
  })
}

