function getNewMesh() {
  t11 = 0
  t12 = 0
  scene = []

  const camChunk = worldToChunk(camera.x, camera.z)
  for (const c of world.chunks as any) {
    if (!c || !c.has_mesh) continue
    t12++
    const dx = c.x - camChunk.cx
    const dz = c.z - camChunk.cz
    const dist2 = dx * dx + dz * dz
    if (dist2 > RENDER_RADIUS * RENDER_RADIUS) continue
    //if (!isChunkInFrustum(c)) continue // <-- Frustum-Culling check
    t12--
    t11++
    for (let i = 0; i < c.mesh.length; i++) {
      scene.push(c.mesh[i])
    }
  }
}

function isChunkInFrustum(chunk: chunk): boolean {
  const chunkSizeX = sChunkX
  const chunkSizeY = sChunkYA * sChunkY
  const chunkSizeZ = sChunkZ

  // Chunk-Mittelpunkt
  const cx = chunk.x * sChunkX + chunkSizeX / 2
  const cy = chunkSizeY / 2
  const cz = chunk.z * sChunkZ + chunkSizeZ / 2

  const dx = cx - camera.x
  const dy = cy - camera.y
  const dz = cz - camera.z

  const dist2 = dx * dx + dz * dz
  if (dist2 < minCCullD22) return true

  const forward = [camera.yawSin, 0, camera.yawCos] // grob: Kamera-Richtung
  const dot = dx * forward[0] + dy * forward[1] + dz * forward[2]
  if (dot < 0) return false // hinter der Kamera

  // Distanzlimit optional
  //const dist = Math.hypot(dx, dy, dz)
  //if (dist > maxChunkViewDist) return false

  return true
}

function getChunkLOD(c: chunk): number {
  const cx = c.x * sChunkX + sChunkX / 2
  const cz = c.z * sChunkZ + sChunkZ / 2
  const dx = cx - camera.x
  const dz = cz - camera.z
  const distSq = dx * dx + dz * dz

  if (distSq < 64) return 0 // volle Detailtiefe
  if (distSq < 256) return 1 // LOD1
  if (distSq < 1024) return 2 // LOD2
  return 3 // LOD3 (nur grobe Blöcke)
}

function buildChunkMesh(c: chunk) {
  //const lod = getChunkLOD(c)
  //const step = Math.pow(2, lod)
  for (let y = 0; y < sChunkYA * sChunkY; y += 1) {
    greedyYFace(c, y)
  }

  // Second pass for side faces on the X-axis
  for (let x = 0; x < sChunkX; x += 1) {
    greedyXFace(c, x)
  }

  // Third pass for side faces on the Z-axis
  for (let z = 0; z < sChunkZ; z += 1) {
    greedyZFace(c, z)
  }
}

