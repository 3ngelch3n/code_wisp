function getBlockColors(block: blockTypes): blockColors | null {
  return blockPalette.find((b) => b.blockType === block) ?? null
}

function blendColor(c1: number, c2: number, t: number): number {
  t = Math.max(0, Math.min(1, t))

  const r1 = (c1 >> 16) & 0xff
  const g1 = (c1 >> 8) & 0xff
  const b1 = c1 & 0xff

  const r2 = (c2 >> 16) & 0xff
  const g2 = (c2 >> 8) & 0xff
  const b2 = c2 & 0xff

  const r = Math.round(r1 + (r2 - r1) * t)
  const g = Math.round(g1 + (g2 - g1) * t)
  const b = Math.round(b1 + (b2 - b1) * t)

  return (r << 16) | (g << 8) | b
}

function createCloneObj(
  costume: string,
  x: number,
  y: number,
  size: number,
  layer: number,
  tint: number = 0xffffff,
): GameObject {
  const cln = createClone()
  cln.x = x
  cln.y = y
  cln.setCostume(costume)
  cln.size = size
  cln.layer = layer
  cln.visible = true
  cln.tint = tint
  cln.data.permanent = true
  return cln
}


