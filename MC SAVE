const sChunkX = 16
const sChunkY = 16
const sChunkYA = 4
const sChunkZ = 16
const sChunkXYZ = sChunkX * sChunkY * sChunkZ
const chunkSaveR = Math.round(nonfullchunkSafeLimRate * sChunkXYZ)
interface ChunkJob {
  x: number
  z: number
  priority: number
  type: "load" | "mesh" | "unmesh" | "unload"
}

const chunkQueue: ChunkJob[] = []
const world: world = { chunks: [] }
const chunkChanges: chunkChangesI[] = []
function generateStartChunks() {
  for (let cx = -CS; cx <= CS; cx++) {
    for (let cz = -CS; cz <= CS; cz++) {
      generateChunk(cx, cz)
    }
  }
}

function saveChunk(x: number, z: number) {
  const c = getChunkAt(x, z)
  if (!c) return

  let newChunkChange: chunkChangesI = { cx: x, cz: z }

  for (const sc of c.subChunks as any) {
    if (!sc.changed) continue

    const heightMap = generateHeightMap(x, z)
    const defaultSC = generateSubChunk(sc.y, heightMap)

    const changedBlocks: blockChange[] = []

    for (let i = 0; i < sc.blocks.length; i++) {
      if (sc.blocks[i] !== defaultSC.blocks[i]) {
        changedBlocks.push({ sCy: sc.y, index: i, type: sc.blocks[i] })
      }
    }

    if (changedBlocks.length > chunkSaveR) {
      if (!newChunkChange.subChunks) newChunkChange.subChunks = []
      newChunkChange.subChunks.push({ ...sc })
    } else if (changedBlocks.length > 0) {
      if (!newChunkChange.blockChange) newChunkChange.blockChange = []
      newChunkChange.blockChange.push(...(changedBlocks as any))
    }

    sc.changed = false
  }

  if (
    (newChunkChange.subChunks && newChunkChange.subChunks.length) ||
    (newChunkChange.blockChange && newChunkChange.blockChange.length)
  ) {
    const existing = chunkChanges.find((ch) => ch.cx === x && ch.cz === z)
    if (existing) Object.assign(existing, newChunkChange)
    else chunkChanges.push(newChunkChange)
  }
}

