function generateChunk(x: number, y: number) {
  const c = createChunk(x, y)
  world.chunks.push(c)
  return c
}

function queueJob(
  x: number,
  z: number,
  type: "load" | "mesh" | "unmesh" | "unload",
  priority: number,
) {
  // Vermeide doppelte Jobs
  if (!chunkQueue.find((j) => j.x === x && j.z === z && j.type === type))
    chunkQueue.push({ x, z, type, priority })
  //console.log(chunkQueue)
}

function getNextJob(): ChunkJob | undefined {
  // sortiere nach Priority (niedrig = hohe Prio)
  chunkQueue.sort((a, b) => a.priority - b.priority)
  return chunkQueue.shift()
}
