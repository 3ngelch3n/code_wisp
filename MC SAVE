function updatePhysics() {
  if (camera.gamemode === gamemodes.survival) {
    camera.yVel += gravity * globals.deltaTime * Tspeed
  }

  // Friction
  const friction = onGround ? frictionGround : frictionAir
  camera.xVel -= camera.xVel * friction * globals.deltaTime * Tspeed
  camera.zVel -= camera.zVel * friction * globals.deltaTime * Tspeed

  // Max-Speed
  let currentMaxSpeed = toggleSprint ? maxSpeed * sprintMultiplier : maxSpeed
  const horizSpeed = Math.hypot(camera.xVel, camera.zVel)
  if (horizSpeed > currentMaxSpeed) {
    const excess = horizSpeed - currentMaxSpeed
    const reduction = excess * 0.9 // nur 10% pro Tick abbauen
    const scale = (horizSpeed - reduction) / horizSpeed
    camera.xVel *= scale
    camera.zVel *= scale
  }

  // Bewegung + Kollisionscheck
  onGround = false
  moveCamera(
    camera.xVel * globals.deltaTime * Tspeed,
    camera.yVel * globals.deltaTime * Tspeed,
    camera.zVel * globals.deltaTime * Tspeed,
  )
}

function moveCamera(dx: number, dy: number, dz: number) {
  camera.y += dy
  if (collisionEnabled && collidesAxis("y", dy)) {
    if (dy < 0) onGround = true // nur wenn runter → Boden
    camera.y -= dy
    camera.yVel = 0
  }

  camera.x += dx
  if (collisionEnabled && collidesAxis("x", dx)) {
    camera.x -= dx
    camera.xVel = 0
  }

  // Z
  camera.z += dz
  if (collisionEnabled && collidesAxis("z", dz)) {
    camera.z -= dz
    camera.zVel = 0
  }
  const moving =
    Math.abs(camera.xVel) > epsilon || Math.abs(camera.zVel) > epsilon
  const targetFov =
    toggleSprint && moving
      ? camera.baseFov * sprintFovMultiplier
      : camera.baseFov
  const fovLerp = 0.1 // Geschwindigkeit des FOV-Übergangs (0.05-0.2)
  camera.fov += (targetFov - camera.fov) * fovLerp
  camera.scale = Math.tan(camera.fov / 2)
}

function collidesAxis(axis: "x" | "y" | "z", delta: number): boolean {
  const minX = Math.floor(camera.x - camera.width / 2)
  const maxX = Math.floor(camera.x + camera.width / 2)
  const minY = Math.floor(camera.y - camera.height)
  const maxY = Math.floor(camera.y)
  const minZ = Math.floor(camera.z - camera.depth / 2)
  const maxZ = Math.floor(camera.z + camera.depth / 2)

  if (axis === "x") {
    const checkX = delta > 0 ? maxX : minX
    for (let y = minY; y <= maxY; y++) {
      for (let z = minZ; z <= maxZ; z++) {
        if (getBlockWorld(checkX, y, z) !== blockTypes.air) {
          return true
        }
      }
    }
  }

  if (axis === "y") {
    const checkY = delta > 0 ? maxY : minY
    for (let x = minX; x <= maxX; x++) {
      for (let z = minZ; z <= maxZ; z++) {
        if (getBlockWorld(x, checkY, z) !== blockTypes.air) {
          return true
        }
      }
    }
  }

  if (axis === "z") {
    const checkZ = delta > 0 ? maxZ : minZ
    for (let x = minX; x <= maxX; x++) {
      for (let y = minY; y <= maxY; y++) {
        if (getBlockWorld(x, y, checkZ) !== blockTypes.air) {
          return true
        }
      }
    }
  }

  return false
}

function isInsideBlock(): boolean {
  const minX = Math.floor(camera.x - camera.width / 2)
  const maxX = Math.floor(camera.x + camera.width / 2)
  const minY = Math.floor(camera.y - camera.height)
  const maxY = Math.floor(camera.y)
  const minZ = Math.floor(camera.z - camera.depth / 2)
  const maxZ = Math.floor(camera.z + camera.depth / 2)

  for (let x = minX; x <= maxX; x++) {
    for (let y = minY; y <= maxY; y++) {
      for (let z = minZ; z <= maxZ; z++) {
        if (getBlockWorld(x, y, z) !== blockTypes.air) {
          return true // Kamera befindet sich in einem Block
        }
      }
    }
  }

  return false // alles frei
}

function blockAiming() {
  const rayDir = cameraRayForHit()
  const hit = voxelRaycastWorld(
    [camera.x, camera.y, camera.z],
    rayDir,
    camera.reach,
  )
  if (hit) {
    camera.hitBlock = hit.pos
    camera.hitSide = hit.face
  } else {
    camera.hitBlock = []
  }
}

function blockInteractions() {
  if (!(attack || use) || !camera.hitBlock.length) return

  let updated = false
  let [bx, by, bz] = camera.hitBlock as any

  if (attack) {
    const cx = Math.floor(bx / sChunkX),
      cz = Math.floor(bz / sChunkZ),
      cy = Math.floor(by)
    const chunk = getChunkAt(cx, cz)
    if (!chunk) return
    const lx = ((bx % sChunkX) + sChunkX) % sChunkX
    const lz = ((bz % sChunkZ) + sChunkZ) % sChunkZ
    const bblock = getBlock(chunk, lx, cy, lz)
    //console.log("b", bblock, blockTypeNames[bblock])
    if (useItems) addItemToNearestSlot(items[blockTypeNames[bblock]], 1)
    setBlock(chunk, lx, cy, lz, blockTypes.air)

    updated = true
