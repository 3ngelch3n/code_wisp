function PV_drawLineZB(p0: Vec3, p1: Vec3, color: number) {
  const mapX = (x: number) => Math.floor(((x + SW2) / (SW2 * 2)) * textWidth)
  const mapY = (y: number) => Math.floor(((y + SH2) / (SH2 * 2)) * textHeight)

  let x0 = mapX(p0[0])
  let y0 = mapY(p0[1])
  let x1 = mapX(p1[0])
  let y1 = mapY(p1[1])
  const z0 = -p0[2]
  const z1 = -p1[2]

  const dx = Math.abs(x1 - x0)
  const dy = Math.abs(y1 - y0)
  const sx = x0 < x1 ? 1 : -1
  const sy = y0 < y1 ? 1 : -1
  let err = dx - dy

  let steps = Math.max(dx, dy)
  if (steps < 1000)
    for (let i = 0; i <= steps; i++) {
      const t = steps === 0 ? 0 : i / steps
      const z = z0 * (1 - t) + z1 * t
      const index = y0 * textWidth + x0
      if (z > zBuffer[index]) {
        PV_setPixel(Math.floor(x0), Math.floor(y0), color)
        zBuffer[index] = z
      }

      if (x0 === x1 && y0 === y1) break
      const e2 = 2 * err
      if (e2 > -dy) {
        err -= dy
        x0 += sx
      }
      if (e2 < dx) {
        err += dx
        y0 += sy
      }
    }
}

function PV_setPixelGenerous(x: number, y: number, color: number) {
  const offsets = [
    [0, 0],
    [-1, 0],
    [1, 0],
    [0, -1],
    [0, 1],
  ]
  for (const [dx, dy] of offsets as any) {
    const nx = x + dx
    const ny = y + dy
    if (nx < 0 || nx >= textWidth || ny < 0 || ny >= textHeight) continue
    const index = ny * textWidth + nx
    if (pixelColors[index] !== color) {
      textObjects[index].style.fill = color
      pixelColors[index] = color
    }
  }
}

